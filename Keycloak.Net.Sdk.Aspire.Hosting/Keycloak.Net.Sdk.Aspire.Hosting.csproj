<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <Version>1.0.0</Version>
        <Authors>Milad.Rv</Authors>
        <Title>Keycloak.Net.Sdk.Aspire.Hosting</Title>
        <Description>.NET Aspire AppHost integration for Keycloak.Net.Sdk — adds Keycloak as a container resource in your Aspire AppHost</Description>
        <RepositoryUrl>https://github.com/MiladRv/Keycloak.Net</RepositoryUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Copyright>Copyright © 2024 Milad.Rv</Copyright>
        <PackageProjectUrl>https://github.com/MiladRv/Keycloak.Net</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryType>git</RepositoryType>
        <PackageTags>keycloak;aspire;dotnet-aspire;hosting;auth</PackageTags>
        <PackageReleaseNotes>https://github.com/MiladRv/Keycloak.Net/releases</PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.Hosting" Version="9.0.0" />
    </ItemGroup>

</Project>
