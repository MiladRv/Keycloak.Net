<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <Version>1.0.0</Version>
        <Authors>Milad.Rv</Authors>
        <Title>Keycloak.Net.Sdk.AspNetCore</Title>
        <Description>ASP.NET Core integration for Keycloak: JWT bearer validation, Keycloak realm and client roles as role claims, role policies, and data-scope helpers for filtering queries by token attributes</Description>
        <RepositoryUrl>https://github.com/MiladRv/Keycloak.Net</RepositoryUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Copyright>Copyright © 2024 Milad.Rv</Copyright>
        <PackageProjectUrl>https://github.com/MiladRv/Keycloak.Net</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryType>git</RepositoryType>
        <PackageTags>keycloak;aspnetcore;jwt;authorization;roles;openid</PackageTags>
        <PackageReleaseNotes>https://github.com/MiladRv/Keycloak.Net/releases</PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
        <InternalsVisibleTo Include="Keycloak.Net.Sdk.UnitTests" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.34" />
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.23" />
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.8" />
    </ItemGroup>

</Project>
